pipeline {
    agent any

    stages {

        stage('Deploy STAGING (FAST)') {
            steps {
                sh '''
                    set -e

                    cd /srv/apps/undangan-stg

                    echo "📥 Pull latest code"
                    git pull origin develop

                    echo "🧹 Stop container"
                    docker-compose down || true

                    echo "🚀 Start container (NO rebuild full)"
                    docker-compose up -d

                    echo "✅ Container running"
                '''
            }
        }

        stage('Laravel Optimize') {
            steps {
                sh '''
                    set -e

                    cd /srv/apps/undangan-stg

                    CONTAINER=$(docker-compose ps -q app)

                    if [ -z "$CONTAINER" ]; then
                        echo "❌ Container not found"
                        exit 1
                    fi

                    echo "⚙️ Fix git safe.directory"
                    docker exec $CONTAINER git config --global --add safe.directory /var/www/html || true

                    echo "⚙️ Laravel optimize"

                    docker exec $CONTAINER php artisan optimize:clear || true
                    docker exec $CONTAINER composer dump-autoload --optimize || true
                    docker exec $CONTAINER php artisan storage:link || true
                '''
            }
        }
    }

    post {
        success {
            echo "🎉 STAGING SUCCESS"
        }
        failure {
            echo "❌ STAGING FAILED"
        }
    }
}