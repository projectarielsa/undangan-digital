pipeline {
    agent any

    stages {

        stage('Deploy STAGING') {
            steps {
                sh '''
                    set -e

                    cd /srv/apps/undangan-stg

                    git config --global --add safe.directory /srv/apps/undangan-stg

                    echo "📥 Pull latest code"
                    git pull origin develop

                    echo "🛑 Stop container"
                    docker-compose -p undangan-stg -f docker/docker-compose.stg.yml down || true

                    echo "🚀 Build & Start"
                    docker-compose -p undangan-stg -f docker/docker-compose.stg.yml up -d --build
                '''
            }
        }

        stage('Laravel Optimize') {
            steps {
                sh '''
                    set -e

                    cd /srv/apps/undangan-stg

                    CONTAINER=$(docker-compose -p undangan-stg -f docker/docker-compose.stg.yml ps -q app)

                    docker exec $CONTAINER php artisan optimize:clear || true
                    docker exec $CONTAINER composer dump-autoload --optimize || true
                    docker exec $CONTAINER php artisan storage:link || true

                    docker exec $CONTAINER chown -R www-data:www-data storage bootstrap/cache
                    docker exec $CONTAINER chmod -R 775 storage bootstrap/cache
                '''
            }
        }
    }
}